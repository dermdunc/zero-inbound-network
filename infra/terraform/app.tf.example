# Template for a second (or first, real) hosted app. Copy this file to a real
# name (e.g. app-myservice.tf), fill in the values, and add it to version control -
# this .example file itself is never loaded by Terraform.
#
# This is the reuse story made literal: a new hosted app is one more block like
# this, not a new set of hand-maintained resources.

module "myservice" {
  source = "./modules/hosted-app"

  name        = "myservice"    # becomes myservice.<base_domain>
  name_prefix = var.name_prefix
  vpc_id      = aws_vpc.this.id
  subnet_ids  = [for s in aws_subnet.public : s.id]
  cluster_id  = aws_ecs_cluster.this.id

  container_image = "<account>.dkr.ecr.<region>.amazonaws.com/myservice:<tag>" # pinned, never :latest
  container_port  = 8080
  desired_count   = 0 # start dark; flip to 1 once the image exists and DNS/Access are verified

  cloudflared_image = "cloudflare/cloudflared:2024.10.0" # check for a current release before applying

  cloudflare_account_id = var.cloudflare_account_id
  cloudflare_zone_id    = var.cloudflare_zone_id
  base_domain           = var.base_domain
  github_idp_id         = cloudflare_zero_trust_access_identity_provider.github.id
  google_idp_id         = cloudflare_zero_trust_access_identity_provider.google.id

  allowed_emails           = ["you@example.test"]
  allowed_google_domain    = null
  github_oidc_provider_arn = local.github_oidc_provider_arn
  github_repo               = "your-org/myservice-repo" # exact owner/repo, no wildcards
}
